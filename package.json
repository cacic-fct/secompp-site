{
  "name": "astr",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build:analytics": "mkdir -p public/js && bun build src/analytics/cacic-umami-tracking.ts --target=browser --format=iife --outfile=public/js/cacic-umami-tracking.js --minify",
    "build": "bun run build:analytics && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint": "prettier --check . && eslint 'src/**/*.{js,astro,ts,svelte}'"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@cacic-fct/account-manager-cookie-banner": "^0.1.3",
    "@cacic-fct/account-manager-privacy": "^0.1.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@twemoji/parser": "^17.0.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "astro": "7.2.4",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "lucide-astro": "^0.471.0",
    "lucide-svelte": "^0.471.0",
    "markdown-it": "^15.0.0",
    "sharp": "^0.35.3",
    "svelte": "^5.56.9",
    "typescript": "^5.9.3",
    "unleash-proxy-client": "^3.8.2"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.25.12",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "^8.67.0",
    "daisyui": "^5.7.19",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.26",
    "postcss-import": "^16.2.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  },
  "trustedDependencies": [
    "sharp"
  ]
